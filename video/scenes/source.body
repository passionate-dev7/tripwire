<style>
.panel{position:absolute;left:120px;top:60px;width:1360px;height:765px;overflow:hidden;border:1px solid var(--hair2);border-radius:10px;background:#000}
.stage{}#stage{position:absolute;left:0;top:0;width:1360px;transform-origin:0 0;will-change:transform}
.panel img{position:absolute;left:0;top:0;width:1360px;height:765px;transform-origin:0 0;will-change:transform}
.spot{position:absolute;border:3px solid var(--ink);border-radius:8px;box-shadow:0 0 0 2000px rgba(7,8,10,.66);opacity:0}
.src{position:absolute;left:120px;top:842px;font:400 16px "PM";color:var(--mute);white-space:nowrap}
.src b{color:var(--ink);font-weight:500}
</style>
<div class="panel" id="panel"><div id="stage"><img id="img"><div class="spot" id="spot"></div></div></div>
<div class="src" id="src"></div>
<script src="engine.js"></script>
<script>
// cues: img, hl:[l,t,w,h] fractions of the image, zoom, src (label), t0, hlAt, dur
const img = $("#img"); img.src = cue("img", "");
const ASP = cue("aspect", 1.78), PHH = Math.round(1360 / ASP); $("#panel").style.height = PHH + "px"; $("#panel").style.top = Math.round((800 - PHH) / 2) + "px"; img.style.height = PHH + "px"; $("#src").style.top = Math.round((800 - PHH) / 2) + PHH + 22 + "px";
$("#src").innerHTML = cue("src", "");
const hl = cue("hl", [0.1, 0.1, 0.5, 0.2]), Z = cue("zoom", 1.5), PW = 1360, PH = Math.round(1360 / ASP);
window.render = (t) => {
  const a = cue("t0", 0.1), h = cue("hlAt", 1.2), z = Z > 1 ? eio(seg(t, h, h + 1.4)) : 0;
  $("#panel").style.opacity = eo(seg(t, a, a + 0.35));
  $("#src").style.opacity = eo(seg(t, a + 0.3, a + 0.7));
  const cx = (hl[0] + hl[2] / 2) * PW, cy = (hl[1] + hl[3] / 2) * PH;
  const s = 1 + (Z - 1) * z, drift = 1 + 0.012 * seg(t, 0, cue("dur", 8)), k = s * drift;
  const tx = Math.min(0, Math.max(PW - PW * k, (PW / 2 - cx * s) * z)), ty = Math.min(0, Math.max(PH - PH * k, (PH / 2 - cy * s) * z));
  $("#stage").style.transform = `translate(${tx}px,${ty}px) scale(${k})`;
  const sp = $("#spot");
  sp.style.left = hl[0] * PW + "px"; sp.style.top = hl[1] * PH + "px"; sp.style.width = hl[2] * PW + "px"; sp.style.height = hl[3] * PH + "px";
  sp.style.borderWidth = 3 / k + "px";
  sp.style.opacity = eo(seg(t, h - 0.2, h + 0.5));
};
</script>
